generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

model AccessRequest {
  id              String    @id @default(uuid())
  ipAddress       String
  deviceId        String    @unique
  status          String    @default("PENDING")
  timeoutUntil    DateTime?
  reason          String?
  lastActive      DateTime  @default(now())
  lastRequestedAt DateTime  @default(now()) // <-- BARU: Untuk Rate Limit
  createdAt       DateTime  @default(now())
}

model BugReport {
  id        String   @id @default(uuid())
  deviceId  String
  message   String
  status    String   @default("PENDING") // PENDING, RESOLVED
  createdAt DateTime @default(now())
}

model AuditLog {
  id             String   @id @default(uuid())
  adminName      String   @default("Hans")
  action         String
  targetDeviceId String
  details        String?
  createdAt      DateTime @default(now())
}

model Relasi {
  id          String   @id @default(cuid())
  citizenId   String   @unique            // unik di level DB (anti duplikat / race condition)
  firstName   String
  lastName    String
  dob         String?                     // YYYY-MM-DD
  sex         String?                     // MALE | FEMALE
  nationality String?
  rank        String?                     // jabatan di CC, mis. Caporegime
  relation    String?                     // keterangan hubungan
  notes       String?
  active      Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])                       // filter aktif/nonaktif
  @@index([lastName, firstName])          // pencarian / urutan nama
}

// <-- BARU: Tabel Faction -->
model Faction {
  id        String   @id @default(uuid())
  label     String
  short     String
  matchType String
  badge     String
  dot       String
  side      String?  // <-- TAMBAHKAN INI
  color     String?  // <-- TAMBAHKAN INI
  createdAt DateTime @default(now())
}
