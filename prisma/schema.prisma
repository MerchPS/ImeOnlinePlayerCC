generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

model AccessRequest {
  id              String    @id @default(uuid())
  ipAddress       String
  deviceId        String    @unique
  status          String    @default("PENDING")
  timeoutUntil    DateTime?
  reason          String?
  lastActive      DateTime  @default(now())
  lastRequestedAt DateTime  @default(now()) // <-- BARU: Untuk Rate Limit
  createdAt       DateTime  @default(now())
}

model BugReport {
  id        String   @id @default(uuid())
  deviceId  String
  message   String
  status    String   @default("PENDING") // PENDING, RESOLVED
  createdAt DateTime @default(now())
}

model AuditLog {
  id             String   @id @default(uuid())
  adminName      String   @default("Hans")
  action         String
  targetDeviceId String
  details        String?
  createdAt      DateTime @default(now())
}

model Relasi {
  id          String   @id @default(cuid())
  citizenId   String   @unique            // unik di level DB (anti duplikat / race condition)
  firstName   String
  lastName    String
  dob         String?                     // YYYY-MM-DD
  sex         String?                     // MALE | FEMALE
  nationality String?
  rank        String?                     // jabatan di CC, mis. Caporegime
  relation    String?                     // keterangan hubungan
  notes       String?
  active      Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])                       // filter aktif/nonaktif
  @@index([lastName, firstName])          // pencarian / urutan nama
}

// Tambahkan ke prisma/schema.prisma, lalu jalankan:
//   npx prisma migrate dev --name add_ai_usage      (atau: npx prisma db push)
//   npx prisma generate

// Ringkasan pemakaian token per hari / fitur / perangkat. Satu baris per kombinasi,
// diisi lewat upsert + increment (atomik), jadi tabel tidak membengkak.
model AiUsageDaily {
  id               String   @id @default(cuid())
  day              String                       // YYYY-MM-DD (WIB)
  endpoint         String                       // "chat" | "faction"
  deviceId         String                       // "-" jika tidak ada
  calls            Int      @default(0)         // panggilan ke provider AI
  cacheHits        Int      @default(0)         // nama yang dijawab dari cache (0 token)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  errors           Int      @default(0)
  estimated        Int      @default(0)         // panggilan yang tokennya diperkirakan (provider tak kirim usage)
  updatedAt        DateTime @updatedAt

  @@unique([day, endpoint, deviceId])
  @@index([day])
}

// Cache bersama hasil klasifikasi faction (nama player -> faction), berlaku lintas user.
model AiFactionCache {
  name      String   @id                       // nama player, lowercase + trim
  factionId String                             // id faction atau "WARGA"
  sig       String                             // tanda tangan daftar faction saat diklasifikasi
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

// <-- BARU: Tabel Faction -->
model Faction {
  id        String   @id @default(uuid())
  label     String
  short     String
  matchType String
  badge     String
  dot       String
  side      String?  // <-- TAMBAHKAN INI
  color     String?  // <-- TAMBAHKAN INI
  createdAt DateTime @default(now())
}
